# Tushare token for data sync (never commit the real file).
TUSHARE_TOKEN=

# Web login. Set exactly one of ASHARE_PASSWORD (hashed on startup) or
# ASHARE_PASSWORD_HASH (pre-hashed scrypt string). There is no default password.
ASHARE_PASSWORD=
# ASHARE_PASSWORD_HASH=scrypt$<salt>$<digest>

# Stable session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ASHARE_SECRET_KEY=

# Set to 1 only behind HTTPS (usually via a reverse proxy).
ASHARE_HTTPS_ONLY=0

# Optional overrides for local (non-Docker) runs.
# ASHARE_DATABASE_URL=sqlite:///data/app.db
# ASHARE_ENABLE_SCHEDULER=1
